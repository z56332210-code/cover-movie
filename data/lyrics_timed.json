  "ko": "손가락을 깨물며 기다리고 있었어"
 },
 {
  "id": 19,
  "section": "pre",
  "start": 59.92,
  "end": 62.06,
  "ja": "とんちんかんな名前呼ばれたんだ",
  "ko": "엉뚱한 이름으로 불리고 있었어"
 },
 {
  "id": 20,
  "section": "chorus1",
  "start": 62.11,
  "end": 65.67,
  "ja": "嗚呼人類最後に愛を持ったって",
  "ko": "아아, 인류 최후로 사랑을 가져봤자"
 },
 {
  "id": 21,
  "section": "chorus1",
  "start": 65.72,
  "end": 69.26,
  "ja": "僕に居場所はないでしょうか",
  "ko": "내게 있을 곳은 없는 걸까"
 },
 {
  "id": 22,
  "section": "chorus1",
  "start": 69.31,
  "end": 73.67,
  "ja": "心中泣いて痛いから思い出してよ",
  "ko": "마음 속으로 울고 아프니까 떠올려줘"
 },
 {
  "id": 23,
  "section": "chorus1",
  "start": 73.72,
  "end": 77.38,
  "ja": "人類最後に愛を持ったって",
  "ko": "인류 최후로 사랑을 가져봤자"
 },
 {
  "id": 24,
  "section": "chorus1",
  "start": 77.43,
  "end": 80.86,
  "ja": "それを知る日はないでしょうなんて",
  "ko": "그걸 알게 될 날은 오지 않겠지 라며"
 },
 {
  "id": 25,
  "section": "chorus1",
  "start": 80.91,
  "end": 82.49,
  "ja": "今日をくらった",
  "ko": "오늘을 먹었어"
 },
 {
  "id": 26,
  "section": "C",
  "start": 84.39,
  "end": 88.05,
