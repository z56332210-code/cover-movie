  "ko": "유종 최후의 불을 밝혀봐도"
 },
 {
  "id": 27,
  "section": "C",
  "start": 88.1,
  "end": 91.4,
  "ja": "心苦しくなるでしょうか",
  "ko": "가슴 아파질 뿐일까"
 },
 {
  "id": 28,
  "section": "C",
  "start": 91.45,
  "end": 95.94,
  "ja": "本当は咲いてみたいってこと思い出したんだ",
  "ko": "사실은 피어나보고 싶었다는 걸 떠올렸어"
 },
 {
  "id": 29,
  "section": "C",
  "start": 95.99,
  "end": 101.04,
  "ja": "たどり着いたんだ正体と擬態したアイを",
  "ko": "다다랐어 정체와 의태한 사랑을"
 },
 {
  "id": 30,
  "section": "chorus2",
  "start": 101.09,
  "end": 104.52,
  "ja": "嗚呼人類最後にアイを持ったって",
  "ko": "아아, 인류 최후로 사랑을 가져봤자"
 },
 {
  "id": 31,
  "section": "chorus2",
  "start": 104.57,
  "end": 107.54,
  "ja": "僕の印はないでしょうか",
  "ko": "나의 표식은 없는 걸까"
 },
 {
  "id": 32,
  "section": "chorus2",
  "start": 107.59,
  "end": 111.94,
  "ja": "きっとふさわしくないけど思い出してよ",
  "ko": "분명 어울리지 않겠지만 떠올려줘"
 },
 {
  "id": 33,
  "section": "chorus2",
  "start": 111.99,
  "end": 115.31,
  "ja": "九十九回一人で泣いたって",
  "ko": "99번 혼자서 울어봤자"
 },
 {
  "id": 34,
  "section": "chorus2",
  "start": 115.36,
  "end": 117.74,
  "ja": "次の一つはないでしょう",
  "ko": "다음 한 번은 없겠지"
 },
 {
  "id": 35,
  "section": "chorus2",
  "start": 117.79,
  "end": 120.98,
  "ja": "やっと僕を見つけたんだ嗚呼",
  "ko": "드디어 나를 찾아냈어, 아아"
 },
 {
  "id": 36,
  "section": "chorus2",
  "start": 121.03,
  "end": 123.31,
  "ja": "こうやってアイは終わった",
  "ko": "이렇게 사랑은 끝났어"
 },
 {
  "id": 37,
  "section": "outro",
  "start": 128.93,
  "end": 130.73,
  "ja": "see you最愛な",
  "ko": "see you 가장 사랑하는"
 },
 {
