[
 {
  "id": 1,
  "section": "A1",
  "start": 0.55,
  "end": 2.57,
  "ja": "僕は最上最愛の",
  "ko": "나는 최고 최애인"
 },
 {
  "id": 2,
  "section": "A1",
  "start": 2.62,
  "end": 6.32,
  "ja": "この世界に産み落とされたモンスター",
  "ko": "이 세상에 낳아진 몬스터"
 },
 {
  "id": 3,
  "section": "A1",
  "start": 6.37,
  "end": 8.52,
  "ja": "そこは従順傀儡の",
  "ko": "거기는 순종적인 꼭두각시의"
 },
 {
  "id": 4,
  "section": "A1",
  "start": 8.57,
  "end": 11.08,
  "ja": "嫌な時代に振り落とされたもんだ",
  "ko": "기분 나쁜 시대에 떨어진 거야"
 },
 {
  "id": 5,
  "section": "A1",
  "start": 11.13,
  "end": 13.52,
  "ja": "赤い糸を放ったスパイダー",
