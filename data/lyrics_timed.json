 },
 {
  "id": 9,
  "section": "A2",
  "start": 30.42,
  "end": 33.27,
  "ja": "僕は新旧曖昧な",
  "ko": "나는 신구 애매한"
 },
 {
  "id": 10,
  "section": "A2",
  "start": 33.32,
  "end": 36.74,
  "ja": "この世界に産み落とされたモンスター",
  "ko": "이 세상에 낳아진 몬스터"
 },
 {
  "id": 11,
  "section": "A2",
  "start": 36.79,
  "end": 38.53,
  "ja": "そこは一見散漫な",
  "ko": "거기는 언뜻 보기에 산만한"
 },
 {
  "id": 12,
  "section": "A2",
  "start": 38.58,
